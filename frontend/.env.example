# Frontend environment variables (Vercel)
# Public vars in Vite must start with VITE_

# Main backend base URL (without trailing slash)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Auth service URL (without trailing slash)
# If auth endpoints are exposed by the same backend, use the same URL as VITE_API_BASE_URL
VITE_AUTH_API_URL=https://your-auth-service.onrender.com

# Optional legacy alias used by some components
VITE_API_URL=https://your-backend.onrender.com
